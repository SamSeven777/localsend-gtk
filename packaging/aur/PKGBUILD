# Maintainer: SamSeven777 <qiryse7en@gmail.com>
pkgname=localsend-gtk-bin
_pkgname=localsend-gtk
pkgver=0.1.0
pkgrel=1
pkgdesc="Native GTK4/Adwaita GUI for LocalSend in Rust (prebuilt binary)"
arch=('x86_64')
url="https://github.com/SamSeven777/localsend-gtk"
license=('MIT' 'Apache-2.0')
depends=('glibc>=2.39' 'gtk4>=4.12' 'libadwaita>=1.5' 'openssl')
optdepends=(
    'kio: Send with LocalSend action in Dolphin'
    'nautilus: Send with LocalSend script (enable per user; see README)'
)
provides=('localsend-gtk')
conflicts=('localsend-gtk')
source=("${_pkgname}-v${pkgver}-linux-${arch}.tar.gz::https://github.com/SamSeven777/localsend-gtk/releases/download/v${pkgver}/${_pkgname}-v${pkgver}-linux-${arch}.tar.gz")
sha256sums=('8ab87f2aabb4c267a86524ff5266536c00421b591a41792aaf2948440bc144ac')

package() {
    cd "${srcdir}/${_pkgname}-v${pkgver}-linux-${arch}"
    install -D -m 755 "bin/localsend-gtk" "${pkgdir}/usr/bin/localsend-gtk"
    install -D -m 644 "share/applications/org.localsend.localsend_gtk.desktop" "${pkgdir}/usr/share/applications/org.localsend.localsend_gtk.desktop"
    install -D -m 644 "share/icons/hicolor/512x512/apps/localsend-gtk.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/localsend-gtk.png"
    if [ -f "share/kio/servicemenus/localsend-dolphin.desktop" ]; then
        install -D -m 644 "share/kio/servicemenus/localsend-dolphin.desktop" "${pkgdir}/usr/share/kio/servicemenus/localsend-dolphin.desktop"
    fi
    if [ -f "share/nautilus-scripts/Send with LocalSend" ]; then
        install -D -m 755 "share/nautilus-scripts/Send with LocalSend" "${pkgdir}/usr/share/nautilus-scripts/Send with LocalSend"
    fi
    install -D -m 644 "share/doc/localsend-gtk/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -m 644 share/doc/localsend-gtk/LICENSES/*.txt "${pkgdir}/usr/share/licenses/${pkgname}/"
    mkdir -p "${pkgdir}/usr/share/doc/${_pkgname}"
    cp -R share/doc/localsend-gtk/* "${pkgdir}/usr/share/doc/${_pkgname}/"
}
